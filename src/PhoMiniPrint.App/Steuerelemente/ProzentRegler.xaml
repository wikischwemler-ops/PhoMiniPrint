<UserControl x:Class="PhoMiniPrint.App.Steuerelemente.ProzentRegler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PhoMiniPrint.App.Steuerelemente">
    <UserControl.Resources>
        <Style x:Key="SpurLinks" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="10" CornerRadius="5,0,0,5" Background="{StaticResource Akzent}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpurRechts" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="10" CornerRadius="0,5,5,0" Background="#3A414C" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Griff" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="22" Height="22">
                            <Ellipse Fill="Black" Opacity="0.35" Margin="0,2,0,-2" />
                            <Ellipse x:Name="Knopf" Fill="White" Stroke="{StaticResource Akzent}" StrokeThickness="4" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Knopf" Property="Fill" Value="#FFE3D3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ReglerVorlage" TargetType="Slider">
            <Border Background="Transparent" Height="26">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource SpurLinks}" Command="Slider.DecreaseLarge" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource SpurRechts}" Command="Slider.IncreaseLarge" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource Griff}" />
                    </Track.Thumb>
                </Track>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <TextBlock x:Name="TitelText" VerticalAlignment="Bottom" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Run x:Name="ZahlText" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Akzent}" Text="50" />
                <Run FontSize="15" Foreground="{StaticResource TextGedimmt}" Text="%" />
            </TextBlock>
        </Grid>

        <Slider x:Name="Regler" Template="{StaticResource ReglerVorlage}" Minimum="0" Maximum="100"
                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                IsMoveToPointEnabled="True" Value="50" ValueChanged="Regler_ValueChanged"
                AutomationProperties.Name="{Binding Text, ElementName=TitelText}" />
        <s:ReglerSkala Height="16" Margin="11,0" />

        <!-- Stärke für Schwarz: Grauverlauf und Ergebnis nach der Schwelle -->
        <StackPanel x:Name="GrauVorschau" Margin="0,8,0,0">
            <Border Height="12" CornerRadius="3" ClipToBounds="True" Margin="11,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Black" />
                        <GradientStop Offset="1" Color="White" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Height="12" Margin="11,3,11,0" x:Name="SchwelleFlaeche" Background="White">
                <Rectangle x:Name="SchwelleBalken" Fill="Black" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock Foreground="{StaticResource TextGedimmt}" FontSize="11" Margin="11,4,0,0"
                       Text="oben Graustufen, unten so wird gedruckt" />
        </StackPanel>

        <!-- Druckdichte: aktive Stufe 1–4 -->
        <Grid x:Name="StufenAnzeige" Margin="11,8,11,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border x:Name="Stufe1" Grid.Column="0" Margin="0,0,4,0" CornerRadius="5" Padding="0,4">
                <TextBlock HorizontalAlignment="Center" Text="Stufe 1" FontSize="11" />
            </Border>
            <Border x:Name="Stufe2" Grid.Column="1" Margin="2,0" CornerRadius="5" Padding="0,4">
                <TextBlock HorizontalAlignment="Center" Text="Stufe 2" FontSize="11" />
            </Border>
            <Border x:Name="Stufe3" Grid.Column="2" Margin="2,0" CornerRadius="5" Padding="0,4">
                <TextBlock HorizontalAlignment="Center" Text="Stufe 3" FontSize="11" />
            </Border>
            <Border x:Name="Stufe4" Grid.Column="3" Margin="4,0,0,0" CornerRadius="5" Padding="0,4">
                <TextBlock HorizontalAlignment="Center" Text="Stufe 4" FontSize="11" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
