<Application x:Class="PhoMiniPrint.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Farben (wie docs/bilder/drucker.svg) -->
        <Color x:Key="AkzentFarbe">#F26B1D</Color>
        <SolidColorBrush x:Key="Akzent" Color="{StaticResource AkzentFarbe}" />
        <SolidColorBrush x:Key="AkzentHell" Color="#FF8A45" />
        <SolidColorBrush x:Key="Hintergrund" Color="#14171C" />
        <SolidColorBrush x:Key="Flaeche" Color="#1D2229" />
        <SolidColorBrush x:Key="FlaecheHell" Color="#262C34" />
        <SolidColorBrush x:Key="Linie" Color="#363E49" />
        <SolidColorBrush x:Key="Text" Color="#E8EAED" />
        <SolidColorBrush x:Key="TextGedimmt" Color="#9AA3AF" />
        <SolidColorBrush x:Key="Fehler" Color="#FF6B6B" />
        <SolidColorBrush x:Key="Erfolg" Color="#3ECF8E" />

        <!-- Programm-Icon (docs/bilder/icon.svg) -->
        <DrawingImage x:Key="ProgrammIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1B1B1B" Geometry="M52,0 H204 A52,52 0 0 1 256,52 V204 A52,52 0 0 1 204,256 H52 A52,52 0 0 1 0,204 V52 A52,52 0 0 1 52,0 Z" />
                    <GeometryDrawing Geometry="M86,132 V48 H170 V132">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#F26B1D" Thickness="14" LineJoin="Round" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="44,120,168,92" RadiusX="26" RadiusY="26" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#F26B1D" Thickness="14" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M106,78 H150 M106,66 V90 M150,66 V90">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#F26B1D" Thickness="8" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M78,148 H178">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#F26B1D" Thickness="10" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F26B1D">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="176,182" RadiusX="10" RadiusY="10" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Grundstile -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="Ueberschrift" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextGedimmt}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Karte" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Flaeche}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linie}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FlaecheHell}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linie}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Akzent}" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Knopf" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource FlaecheHell}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linie}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Rahmen" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Akzent}" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Knopf}" />
        <Style TargetType="RadioButton" BasedOn="{StaticResource Knopf}" />

        <Style x:Key="KnopfHaupt" TargetType="Button" BasedOn="{StaticResource Knopf}">
            <Setter Property="Background" Value="{StaticResource Akzent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Akzent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,10" />
        </Style>

        <!-- Menü: Leiste dunkel, aufklappende Einträge im Windows-Stil -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource Flaeche}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="Padding" Value="8,4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
