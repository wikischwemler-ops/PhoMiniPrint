<Window x:Class="PhoMiniPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:PhoMiniPrint.App.Steuerelemente"
        Title="PhoMiniPrint" Height="820" Width="1180"
        MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource ProgrammIcon}"
        Background="{StaticResource Hintergrund}"
        Language="de-DE">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static s:Befehle.BildEinfuegen}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static s:Befehle.Drucken}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{x:Static s:Befehle.TextEinfuegen}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static s:Befehle.BildEinfuegen}" Executed="BildEinfuegen_Click" />
        <CommandBinding Command="{x:Static s:Befehle.Drucken}" Executed="Drucken_Click" />
        <CommandBinding Command="{x:Static s:Befehle.TextEinfuegen}" Executed="TextEinfuegen_Click" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Bild einfügen …" InputGestureText="Strg+O" Click="BildEinfuegen_Click" />
                <MenuItem Header="_Text einfügen …" InputGestureText="Strg+T" Click="TextEinfuegen_Click" />
                <Separator />
                <MenuItem Header="_Beenden" Click="Beenden_Click" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem x:Name="MenueTextBearbeiten" Header="_Text bearbeiten …" Click="TextBearbeiten_Click" />
                <MenuItem x:Name="MenueEinpassen" Header="Maximal _einpassen" Click="Einpassen_Click" />
                <MenuItem x:Name="MenueEntfernen" Header="Element _entfernen" InputGestureText="Entf" Click="Entfernen_Click" />
            </MenuItem>
            <MenuItem Header="Dru_cker">
                <MenuItem x:Name="MenueDrucken" Header="_Drucken" InputGestureText="Strg+P" Click="Drucken_Click" />
                <MenuItem Header="Drucker _suchen" Click="DruckerSuchen_Click" />
            </MenuItem>
        </Menu>

        <!-- Statusleiste -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Linie}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="HinweisText" DockPanel.Dock="Right" Foreground="{StaticResource TextGedimmt}"
                           Text="Ziehen: verschieben · Ecken: Größe · Pfeiltasten: 1 mm, mit Umschalt 1/8 mm" />
                <Ellipse x:Name="DruckerPunkt" Width="9" Height="9" Fill="{StaticResource TextGedimmt}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Drucker: wird gesucht …" />
            </DockPanel>
        </Border>

        <!-- Einstellungen rechts -->
        <ScrollViewer DockPanel.Dock="Right" Width="310" VerticalScrollBarVisibility="Auto" Background="{StaticResource Hintergrund}">
            <StackPanel Margin="0,12,12,12">
                <Border Style="{StaticResource Karte}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Ueberschrift}" Text="ETIKETT" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Länge" />
                            <TextBox x:Name="LaengeFeld" Grid.Column="1" Text="40" />
                            <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextGedimmt}" Text="mm" />
                        </Grid>
                        <TextBlock Margin="0,6,0,10" FontSize="11" Foreground="{StaticResource TextGedimmt}" TextWrapping="Wrap"
                                   Text="Höhe: Band 50 mm, davon 48 mm bedruckbar" />

                        <TextBlock Margin="0,0,0,6" Text="Ränder in mm" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="6" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Width="46" Text="Links" />
                            <TextBox x:Name="RandLinksFeld" Grid.Column="1" Text="2" ToolTip="Abstand vom Anfang des Etiketts" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Width="46" Text="Rechts" />
                            <TextBox x:Name="RandRechtsFeld" Grid.Column="4" Text="2" ToolTip="Abstand vom Ende des Etiketts" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Oben" />
                            <TextBox x:Name="RandObenFeld" Grid.Row="2" Grid.Column="1" Text="2" ToolTip="Abstand von der oberen Papierkante (mindestens 1 mm)" />
                            <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Text="Unten" />
                            <TextBox x:Name="RandUntenFeld" Grid.Row="2" Grid.Column="4" Text="2" ToolTip="Abstand von der unteren Papierkante (mindestens 1 mm)" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ElementKarte" Style="{StaticResource Karte}" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Ueberschrift}" x:Name="ElementTitel" Text="ELEMENT" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BreiteFeld" ToolTip="Breite (Länge entlang des Bandes); die Höhe folgt dem Seitenverhältnis" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="×" />
                            <TextBox x:Name="HoeheFeld" Grid.Column="2" ToolTip="Höhe quer zum Band; die Breite folgt dem Seitenverhältnis" />
                            <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextGedimmt}" Text="mm" />
                        </Grid>
                        <TextBlock Margin="0,10,0,6" Text="Drehen" />
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="Drehen0" GroupName="Drehung" Margin="0,0,3,0" Content="0°" Click="Drehen_Click" Tag="0" />
                            <RadioButton x:Name="Drehen90" GroupName="Drehung" Margin="3,0" Content="90°" Click="Drehen_Click" Tag="90" />
                            <RadioButton x:Name="Drehen180" GroupName="Drehung" Margin="3,0" Content="180°" Click="Drehen_Click" Tag="180" />
                            <RadioButton x:Name="Drehen270" GroupName="Drehung" Margin="3,0,0,0" Content="270°" Click="Drehen_Click" Tag="270" />
                        </UniformGrid>
                        <Button x:Name="TextBearbeitenKnopf" Margin="0,8,0,0" Content="Text bearbeiten …" Click="TextBearbeiten_Click" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Margin="0,0,3,0" Content="Maximal einpassen" Click="Einpassen_Click" />
                            <Button Margin="3,0,0,0" Content="Entfernen" Click="Entfernen_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Karte}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Ueberschrift}" Text="DRUCK" />
                        <s:ProzentRegler x:Name="StaerkeRegler" Titel="Stärke für Schwarz" Art="Schwarz" Wert="50"
                                         ToolTip="Bis zu welcher Helligkeit ein Bildpunkt schwarz gedruckt wird" />
                        <Rectangle Height="1" Fill="{StaticResource Linie}" Margin="0,12" />
                        <s:ProzentRegler x:Name="DichteRegler" Titel="Druckdichte" Art="Dichte" Wert="50"
                                         ToolTip="Wie dunkel der Drucker druckt (4 Stufen)" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FehlerText" Foreground="{StaticResource Fehler}" TextWrapping="Wrap" Margin="2,0,2,8" Visibility="Collapsed" />

                <Button x:Name="DruckenKnopf" Style="{StaticResource KnopfHaupt}" Click="Drucken_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE749;" FontSize="17" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Drucken" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Bandansicht in der Mitte -->
        <Border Margin="12" CornerRadius="10" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Linie}" BorderThickness="1"
                AllowDrop="True" Drop="Datei_Drop" DragOver="Datei_DragOver">
            <Grid>
                <s:Bandansicht x:Name="Ansicht" Margin="8" />

                <!-- Startansicht und Druckanimation -->
                <Grid x:Name="Illustration" Background="{StaticResource Flaeche}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MaxHeight="520" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <s:DruckerAnimation x:Name="Animation" Margin="30,10,30,0" MaxWidth="900" VerticalAlignment="Bottom" />
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,28">
                        <TextBlock x:Name="IllustrationTitel" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Bild oder Text einfügen" />
                        <TextBlock x:Name="IllustrationText" HorizontalAlignment="Center" Margin="0,6,0,14" Foreground="{StaticResource TextGedimmt}"
                                   Text="PNG oder JPG hierher ziehen, ein Bild öffnen oder einen Text mit Symbolen schreiben" />
                        <StackPanel x:Name="StartKnoepfe" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Padding="18,7" Click="BildEinfuegen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEB9F;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Bild einfügen …" />
                                </StackPanel>
                            </Button>
                            <Button Margin="10,0,0,0" Padding="18,7" Click="TextEinfuegen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D2;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Text einfügen …" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
