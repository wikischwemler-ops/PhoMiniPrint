<Window x:Class="PhoMiniPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoMiniPrint" Height="600" Width="1000"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Language="de-DE">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Drucker: nicht verbunden" />
            </StatusBarItem>
        </StatusBar>
        <Grid Background="#1B1B1B">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#F26B1D" FontSize="22"
                       Text="PhoMiniPrint – Grundgerüst" />
        </Grid>
    </DockPanel>
</Window>
