<Window x:Class="PhoMiniPrint.App.InfoFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über PhoMiniPrint" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="{StaticResource ProgrammIcon}"
        Background="{StaticResource Hintergrund}"
        Language="de-DE">
    <StackPanel Margin="22">
        <DockPanel>
            <Image Source="{StaticResource ProgrammIcon}" Width="88" Height="88" Margin="0,0,18,0" VerticalAlignment="Top" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="26" FontWeight="Bold" Text="PhoMiniPrint" />
                <TextBlock x:Name="VersionText" FontSize="15" Foreground="{StaticResource Akzent}" FontWeight="SemiBold" Margin="0,2,0,0" />
                <TextBlock Foreground="{StaticResource TextGedimmt}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Bilder und Text in exakter Größe auf dem Phomemo T02 drucken." />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Karte}" Margin="0,18,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{StaticResource TextGedimmt}" Text="Version" />
                <TextBlock x:Name="VersionWert" Grid.Column="2" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource TextGedimmt}" Margin="0,4,0,0" Text="Erstellt am" />
                <TextBlock x:Name="DatumWert" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" />
                <TextBlock Grid.Row="2" Foreground="{StaticResource TextGedimmt}" Margin="0,4,0,0" Text="Einstellungen" />
                <TextBlock x:Name="EinstellungenWert" Grid.Row="2" Grid.Column="2" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Foreground="{StaticResource TextGedimmt}" Margin="0,4,0,0" Text="Projekt" />
                <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://github.com/wikischwemler-ops/PhoMiniPrint" RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource AkzentHell}">github.com/wikischwemler-ops/PhoMiniPrint</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Ueberschrift}" Margin="2,4,0,6" Text="LIZENZHINWEISE" />
        <TextBox x:Name="HinweisText" Height="150" IsReadOnly="True" TextWrapping="Wrap" FontSize="11"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="8,6"
                 VerticalScrollBarVisibility="Auto" />

        <Button HorizontalAlignment="Right" Margin="0,16,0,0" Padding="22,6" IsCancel="True" IsDefault="True" Content="Schließen" />
    </StackPanel>
</Window>
